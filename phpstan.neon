includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon

parameters:
    level: 6
    # casts() methods (instead of $casts) are only typed when Larastan parses them
    parseModelCastsMethod: true
    # fixed path so CI can cache it between runs
    tmpDir: /tmp/phpstan
    paths:
        - app
        - bootstrap/app.php
        - config
        - database/factories
        - database/seeders
        - routes
    # CI analyses the self-hosted build, where the saas-only packages are missing.
    # These files declare classes on top of them, so they are only scanned, not analysed.
    excludePaths:
        analyse:
            - app/Analytics/VisitorCustomPropertiesResolver.php
            - app/Filament
            - app/Models/Transaction.php
            - app/Models/User.php
            - app/Providers/Filament
            - app/Services/BlogService.php
    reportUnmatchedIgnoredErrors: false
