{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": ["laravel", "framework"],
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "ext-zip": "*",
        "ashallendesign/favicon-fetcher": "^3.5",
        "ashallendesign/laravel-exchange-rates": "^7.2",
        "fakerphp/faker": "^1.9.1",
        "guzzlehttp/guzzle": "^7.2",
        "hisorange/browser-detect": "^5.0",
        "inertiajs/inertia-laravel": "^1.0",
        "joelbutcher/socialstream": "^6.1",
        "lab404/laravel-impersonate": "^1.7",
        "laracraft-tech/laravel-useful-additions": "^4.0",
        "laravel/framework": "^11.0",
        "laravel/horizon": "^5.24",
        "laravel/jetstream": "^5.0",
        "laravel/pulse": "^1.2",
        "laravel/sanctum": "^4.0",
        "laravel/spark-paddle": "^5.1",
        "laravel/tinker": "^2.8",
        "league/iso3166": "^4.3",
        "maatwebsite/excel": "^3.1",
        "mateusjunges/laravel-trackable-jobs": "^1.6",
        "sentry/sentry-laravel": "^4.7",
        "simplestats-io/laravel-client": "dev-main",
        "spatie/laravel-backup": "^8.6",
        "spatie/laravel-ray": "^1.33",
        "spatie/laravel-validation-rules": "^3.3",
        "stevebauman/location": "^7.2",
        "tightenco/ziggy": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.9",
        "laravel/pint": "^1.0",
        "laravel/sail": "^1.18",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.4.4",
        "nunomaduro/collision": "^8.1",
        "pestphp/pest": "^2.0",
        "pestphp/pest-plugin-laravel": "^2.0",
        "spatie/laravel-ignition": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "repositories": {
        "simplestats-io/laravel-client": {
            "type": "path",
            "url": "packages/simplestats-io/laravel-client",
            "options": {
                "symlink": true
            }
        },
        "laravel/spark-paddle": {
            "type": "composer",
            "url": "https://spark.laravel.com"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
